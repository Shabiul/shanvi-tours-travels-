# Shanvi Tours & Travels — Apache hardening
# Note: the PHP built-in dev server (php -S) ignores .htaccess entirely.
# These rules only take effect on Apache hosting (mod_headers, mod_rewrite).

# --- Directory listing & server info -----------------------------------
Options -Indexes
ServerSignature Off

# --- Security headers ----------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set X-XSS-Protection "1; mode=block"
    Header unset X-Powered-By
    # Enable once SSL is active on the live domain:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
<IfModule mod_php.c>
    php_flag expose_php off
</IfModule>

# --- Block direct access to include partials and the raw asset dump -----
<FilesMatch "^(header|footer)\.php$">
    Require all denied
</FilesMatch>

# --- Hide dotfiles (.htaccess, .gitignore, .git, etc.) -------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# --- Turn off PHP error display in production (Apache + mod_php only) ----
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
</IfModule>

# --- Clean URL Rewrites and 404 Handling --------------------------
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 301 Redirect /index.php to / (resolves Alternate page with proper canonical tag)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php[?\ ] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # 301 Redirect legacy coming-soon page to /
    RewriteRule ^index_comingsoon\.html$ / [R=301,L]

    # Check if request without .php matches an existing .php file
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

