{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "*.php", "use": "vercel-php@0.9.0" },
    { "src": "images/**", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "videos/**", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap*.xml", "use": "@vercel/static" },
    { "src": "llms*.txt", "use": "@vercel/static" },
    { "src": "google*.html", "use": "@vercel/static" },
    { "src": "shanvi*.txt", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/videos/(.*)", "dest": "/videos/$1" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap(.*).xml", "dest": "/sitemap$1.xml" },
    { "src": "/llms(.*).txt", "dest": "/llms$1.txt" },
    { "src": "/google(.*).html", "dest": "/google$1.html" },
    { "src": "/shanvi(.*).txt", "dest": "/shanvi$1.txt" },
    { "src": "/index.php", "status": 301, "headers": { "Location": "/" } },
    { "src": "/index_comingsoon.html", "status": 301, "headers": { "Location": "/" } },
    { "src": "/fleet", "dest": "/fleet.php" },
    { "src": "/services", "dest": "/services.php" },
    { "src": "/about", "dest": "/about.php" },
    { "src": "/gallery", "dest": "/gallery.php" },
    { "src": "/contact", "dest": "/contact.php" },
    { "src": "/21-seater-bus-rental-bangalore", "dest": "/21-seater-bus-rental-bangalore.php" },
    { "src": "/blog", "dest": "/blog.php" },
    { "src": "/blog-21-seater-mini-bus-rental-bangalore", "dest": "/blog-21-seater-mini-bus-rental-bangalore.php" },
    { "src": "/blog-tempo-traveller-vs-21-seater-bus", "dest": "/blog-tempo-traveller-vs-21-seater-bus.php" },
    { "src": "/blog-weekend-road-trips-bangalore-21-seater", "dest": "/blog-weekend-road-trips-bangalore-21-seater.php" },
    { "src": "/blog-corporate-team-outing-bus-bangalore", "dest": "/blog-corporate-team-outing-bus-bangalore.php" },
    { "src": "/(.*)\\.php", "dest": "/$1.php" },
    { "src": "/", "dest": "/index.php" },
    { "src": "/(.*)", "status": 404, "dest": "/404.php" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ]
}
