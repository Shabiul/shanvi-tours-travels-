# Raw/unprocessed uploads — source material only, not served by the site.
# Every usable asset from here has already been reviewed, renamed, and
# copied into images/ or videos/ for actual use on the site.
public/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/
.idea/
*.swp

# Logs
*.log

# Local environment / secrets (none currently in this repo, but keep
# this pattern so a future .env is never committed by accident)
.env
.env.*

.vercel

# npm artifacts from occasional `vercel`/CLI runs — this is a plain PHP
# project, there's no real package.json here
node_modules/
package-lock.json

# Raw phone-export media has landed loose in the project root before
# (instead of public/) — catch it wherever it lands so it never gets
# committed by accident again.
WhatsApp Image *.jpeg
WhatsApp Image *.jpg
WhatsApp Video *.mp4
.env*
*service-account*.json
*gsc-key*.json
credentials.json
